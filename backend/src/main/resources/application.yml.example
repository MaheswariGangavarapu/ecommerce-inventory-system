spring:
  application:
    name: ecommerce-inventory-system
  datasource:
    url: jdbc:postgresql://127.0.0.1:5432/ecommerce_inventory_db
    username: postgres
    password: YOUR_PASSWORD_HERE
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    open-in-view: false

server:
  port: 8090
  